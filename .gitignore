# Local environment secrets — never commit. .dev.vars is what `wrangler pages dev`
# reads for the function's bindings (NEON_URL, IP_SALT); the real values belong to
# `wrangler pages secret put`, and neither may ever be a VITE_* variable, which Vite
# would inline into the public bundle.
.env
.env.local
.env.*.local
.dev.vars

# Local runtime state written by `wrangler pages dev`.
.wrangler/
